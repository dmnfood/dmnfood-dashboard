          && selection.startColumn is int && selection.startColumn >= 0 && selection.startColumn < 1024
          && selection.endColumn is int && selection.endColumn >= selection.startColumn && selection.endColumn < 1024
          && selection.range == preparationColumn(selection.startColumn) + string(selection.startRow + 1) + ':' + preparationColumn(selection.endColumn) + string(selection.endRow + 1);
