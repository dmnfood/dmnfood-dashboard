  rules_version = '2';
  service cloud.firestore {
    match /databases/{database}/documents {
      function signedIn() { return request.auth != null; }
      function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
      function activeUser() { return signedIn() && profile().data.isActive == true; }
      function managerOrAdmin() { return activeUser() && (profile().data.role == 'manager' || profile().data.role == 'admin'); }
      function administrator() { return activeUser() && profile().data.role == 'admin'; }
      function validRole(role) { return role == 'worker' || role == 'manager' || role == 'admin'; }
      function validApprovalStatus(status) { return status == 'pending' || status == 'approved' || status == 'rejected'; }
      function validInitialProfile(data) {
        return data.keys().hasOnly(['email', 'displayName', 'employeeName', 'role', 'approvalStatus', 'isActive', 'createdAt', 'updatedAt'])
          && data.email == request.auth.token.email
          && data.displayName is string
          && data.employeeName is string
          && data.role == 'worker'
          && data.approvalStatus == 'pending'
          && data.isActive == false;
      }
      function personalProfileUpdate() {
        return request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.approvalStatus == resource.data.approvalStatus
          && request.resource.data.isActive == resource.data.isActive
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'employeeName', 'updatedAt']);
      }
      function managerWorkerApproval() {
        return resource.data.role == 'worker'
          && request.resource.data.role == 'worker'
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvalStatus', 'isActive', 'updatedAt']);
      }
      function validJudgment(data) {
        return (data.productSurfaceTemperature >= 170 && data.productSurfaceTemperature <= 200 && data.judgment == 'PASS')
          || ((data.productSurfaceTemperature < 170 || data.productSurfaceTemperature > 200) && data.judgment == 'FAIL');
      }
      function validHeatingRecord(data) {
        return data.schemaVersion == 1
          && data.recordDate is string
          && data.inspectorName is string
          && data.productName is string
          && data.roasterNo is number
          && data.setTemperature is number
          && data.measuredTime is string
          && data.heatingMinutes is number
          && data.heatingSeconds is number
          && data.heatingTotalSeconds is number
          && data.productSurfaceTemperature is number
          && data.judgment is string
          && data.createdByUid == request.auth.uid
          && validJudgment(data);
      }
      function validFilteringJudgment(data) {
        return (data.filterMeshDamaged == false
            && data.pressurePsi <= data.judgmentCriteria.pressureLimitPsi
            && data.judgment == 'PASS')
          || ((data.filterMeshDamaged == true
            || data.pressurePsi > data.judgmentCriteria.pressureLimitPsi)
            && data.judgment == 'FAIL');
      }
      function validFilteringRecord(data) {
        return data.schemaVersion == 1
          && data.recordDate is string
          && data.inspectorName is string
          && data.productName is string
          && data.checkedTime is string
          && data.filterMeshDamaged is bool
          && data.pressurePsi is number && data.pressurePsi >= 0
          && data.foreignMaterialDescription is string
          && data.judgment in ['PASS', 'FAIL']
          && data.judgmentCriteria is map
          && data.judgmentCriteria.pressureLimitMpa is number && data.judgmentCriteria.pressureLimitMpa >= 0
          && data.judgmentCriteria.pressureLimitPsi is number && data.judgmentCriteria.pressureLimitPsi >= 0
          && data.judgmentCriteria.meshMustBeIntact == true
          && validFilteringJudgment(data);
      }
      function validBottleWashingJudgment(data) {
        return (data.pressureMpa >= data.judgmentCriteria.minPressureMpa
            && data.washDurationSec >= data.judgmentCriteria.minDurationSec
            && data.judgment == 'PASS'
            && data.failureReasons.size() == 0)
          || ((data.pressureMpa < data.judgmentCriteria.minPressureMpa
              || data.washDurationSec < data.judgmentCriteria.minDurationSec)
            && data.judgment == 'FAIL'
            && data.failureReasons.hasOnly(['pressure_below_limit', 'duration_below_limit'])
            && ((data.pressureMpa < data.judgmentCriteria.minPressureMpa
                && data.failureReasons.hasAny(['pressure_below_limit']))
              || (data.pressureMpa >= data.judgmentCriteria.minPressureMpa
                && !data.failureReasons.hasAny(['pressure_below_limit'])))
            && ((data.washDurationSec < data.judgmentCriteria.minDurationSec
                && data.failureReasons.hasAny(['duration_below_limit']))
              || (data.washDurationSec >= data.judgmentCriteria.minDurationSec
                && !data.failureReasons.hasAny(['duration_below_limit']))));
      }
      function validBottleWashingRecord(data) {
        return data.schemaVersion == 1
          && data.recordDate is string
          && data.measuredTime is string
          && data.inspectorName is string
          && data.containerMaterial in ['glass', 'pet']
          && data.containerVolumeMl is int
          && data.containerVolumeMl in [180, 250, 300, 350, 1000, 1800]
          && data.pressureMpa is number && data.pressureMpa >= 0
          && data.washDurationSec is number && data.washDurationSec >= 0
          && data.washedQuantity is int && data.washedQuantity >= 0
          && data.judgment in ['PASS', 'FAIL']
          && data.failureReasons is list
          && data.deviationDetail is string
          && data.correctiveActionResult is string
          && data.actionBy is string
          && data.verifiedBy is string
          && data.notes is string
          && data.judgmentCriteria is map
          && data.judgmentCriteria.minPressureMpa is number && data.judgmentCriteria.minPressureMpa >= 0
          && data.judgmentCriteria.minDurationSec is number && data.judgmentCriteria.minDurationSec >= 0
          && data.createdByUid is string
          && data.updatedByUid is string
          && validBottleWashingJudgment(data);
      }

      match /users/{uid} {
        // Bootstrap read: a signed-in user must be able to inspect only their own profile before approval.
        allow get: if signedIn() && request.auth.uid == uid;
        allow get, list: if managerOrAdmin();
        allow create: if signedIn() && request.auth.uid == uid && validInitialProfile(request.resource.data);
        allow update: if signedIn() && (
          (request.auth.uid == uid && personalProfileUpdate())
          || (managerOrAdmin() && managerWorkerApproval())
          || administrator()
        );
        allow delete: if administrator();
      }

      match /haccpHeatingRecords/{recordId} {
        allow read: if activeUser();
        allow create: if activeUser() && validHeatingRecord(request.resource.data);
        allow update: if activeUser() && validHeatingRecord(request.resource.data)
          && (resource.data.createdByUid == request.auth.uid || managerOrAdmin());
        allow delete: if activeUser() && (resource.data.createdByUid == request.auth.uid || managerOrAdmin());
      }

      match /haccpSettings/heating {
        allow read: if activeUser();
        allow write: if managerOrAdmin();
      }

      match /haccpFilteringRecords/{recordId} {
        allow read: if activeUser();
        allow create: if activeUser() && validFilteringRecord(request.resource.data)
          && request.resource.data.createdByUid == request.auth.uid;
        allow update: if activeUser() && validFilteringRecord(request.resource.data)
          && request.resource.data.createdByUid == resource.data.createdByUid
          && (resource.data.createdByUid == request.auth.uid || managerOrAdmin());
        allow delete: if activeUser() && (resource.data.createdByUid == request.auth.uid || managerOrAdmin());
      }

      match /haccpSettings/filtering {
        allow read: if activeUser();
        allow write: if managerOrAdmin();
      }

      match /haccpBottleWashingRecords/{recordId} {
        allow read: if activeUser();
        allow create: if activeUser() && validBottleWashingRecord(request.resource.data)
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.updatedByUid == request.auth.uid;
        allow update: if activeUser() && validBottleWashingRecord(request.resource.data)
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.updatedByUid == request.auth.uid
          && (resource.data.createdByUid == request.auth.uid || managerOrAdmin());
        allow delete: if activeUser() && (resource.data.createdByUid == request.auth.uid || managerOrAdmin());
      }

      match /haccpSettings/bottleWashing {
        allow read: if activeUser();
        allow write: if managerOrAdmin();
      }
    }
  }
