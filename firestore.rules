  rules_version = '2';
  service cloud.firestore {
    match /databases/{database}/documents {
      function signedIn() { return request.auth != null; }
      function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
      function activeUser() { return signedIn() && profile().data.isActive == true; }
      function managerOrAdmin() { return activeUser() && (profile().data.role == 'manager' || profile().data.role == 'admin'); }
      function approvedActiveUser() {
        return activeUser()
          && profile().data.get('approvalStatus', 'approved') == 'approved';
      }
      function approvedManagerOrAdmin() {
        return approvedActiveUser() && (profile().data.role == 'manager' || profile().data.role == 'admin');
      }
      // A separate Firebase Auth identity is granted mail-only access by a console-managed record.
      // It has no employee profile and cannot approve orders or read HACCP records.
      function mailCollector() {
        let access = get(/databases/$(database)/documents/integrationAccess/naverworksMail).data;
        return signedIn() && access.enabled == true && access.collectorUid == request.auth.uid;
      }
      function administrator() { return activeUser() && profile().data.role == 'admin'; }
      function validRole(role) { return role == 'worker' || role == 'manager' || role == 'admin'; }
      function validApprovalStatus(status) { return status == 'pending' || status == 'approved' || status == 'rejected'; }
      function validInitialProfile(data) {
        return data.keys().hasOnly(['email', 'displayName', 'employeeName', 'role', 'approvalStatus', 'isActive', 'createdAt', 'updatedAt'])
          && data.email == request.auth.token.email
          && data.displayName is string
          && data.employeeName is string
          && data.role == 'worker'
          && data.approvalStatus == 'pending'
          && data.isActive == false;
      }
      function personalProfileUpdate() {
        return request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.approvalStatus == resource.data.approvalStatus
          && request.resource.data.isActive == resource.data.isActive
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'employeeName', 'updatedAt']);
      }
      function managerWorkerApproval() {
        return resource.data.role == 'worker'
          && request.resource.data.role == 'worker'
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvalStatus', 'isActive', 'updatedAt']);
      }
      function validJudgment(data) {
        return (data.productSurfaceTemperature >= 170 && data.productSurfaceTemperature <= 200 && data.judgment == 'PASS')
          || ((data.productSurfaceTemperature < 170 || data.productSurfaceTemperature > 200) && data.judgment == 'FAIL');
      }
      function validHeatingRecord(data) {
        return data.schemaVersion == 1
          && data.recordDate is string
          && data.inspectorName is string
          && data.productName is string
          && data.roasterNo is number
          && data.setTemperature is number
          && data.measuredTime is string
          && data.heatingMinutes is number
          && data.heatingSeconds is number
          && data.heatingTotalSeconds is number
          && data.productSurfaceTemperature is number
          && data.judgment is string
          && data.createdByUid == request.auth.uid
          && validJudgment(data);
      }
      function validFilteringJudgment(data) {
        return (data.filterMeshDamaged == false
            && data.pressurePsi <= data.judgmentCriteria.pressureLimitPsi
            && data.judgment == 'PASS')
          || ((data.filterMeshDamaged == true
            || data.pressurePsi > data.judgmentCriteria.pressureLimitPsi)
            && data.judgment == 'FAIL');
      }
      function validFilteringRecord(data) {
        return data.schemaVersion == 1
          && data.recordDate is string
          && data.inspectorName is string
          && data.productName is string
          && data.checkedTime is string
          && data.filterMeshDamaged is bool
          && data.pressurePsi is number && data.pressurePsi >= 0
          && data.foreignMaterialDescription is string
          && data.judgment in ['PASS', 'FAIL']
          && data.judgmentCriteria is map
          && data.judgmentCriteria.pressureLimitMpa is number && data.judgmentCriteria.pressureLimitMpa >= 0
          && data.judgmentCriteria.pressureLimitPsi is number && data.judgmentCriteria.pressureLimitPsi >= 0
          && data.judgmentCriteria.meshMustBeIntact == true
          && validFilteringJudgment(data);
      }
      function validBottleWashingJudgment(data) {
        return (data.pressureMpa >= data.judgmentCriteria.minPressureMpa
            && data.washDurationSec >= data.judgmentCriteria.minDurationSec
            && data.judgment == 'PASS'
            && data.failureReasons.size() == 0)
          || ((data.pressureMpa < data.judgmentCriteria.minPressureMpa
              || data.washDurationSec < data.judgmentCriteria.minDurationSec)
            && data.judgment == 'FAIL'
            && data.failureReasons.hasOnly(['pressure_below_limit', 'duration_below_limit'])
            && ((data.pressureMpa < data.judgmentCriteria.minPressureMpa
                && data.failureReasons.hasAny(['pressure_below_limit']))
              || (data.pressureMpa >= data.judgmentCriteria.minPressureMpa
                && !data.failureReasons.hasAny(['pressure_below_limit'])))
            && ((data.washDurationSec < data.judgmentCriteria.minDurationSec
                && data.failureReasons.hasAny(['duration_below_limit']))
              || (data.washDurationSec >= data.judgmentCriteria.minDurationSec
                && !data.failureReasons.hasAny(['duration_below_limit']))));
      }
      function validBottleWashingRecord(data) {
        return data.schemaVersion == 1
          && data.recordDate is string
          && data.measuredTime is string
          && data.inspectorName is string
          && data.containerMaterial in ['glass', 'pet']
          && data.containerVolumeMl is int
          && data.containerVolumeMl in [150, 180, 250, 300, 350, 1000, 1800]
          && data.pressureMpa is number && data.pressureMpa >= 0
          && data.washDurationSec is number && data.washDurationSec >= 0
          && data.washedQuantity is int && data.washedQuantity >= 0
          && data.judgment in ['PASS', 'FAIL']
          && data.failureReasons is list
          && data.deviationDetail is string
          && data.correctiveActionResult is string
          && data.actionBy is string
          && data.verifiedBy is string
          && data.notes is string
          && data.judgmentCriteria is map
          && data.judgmentCriteria.minPressureMpa is number && data.judgmentCriteria.minPressureMpa >= 0
          && data.judgmentCriteria.minDurationSec is number && data.judgmentCriteria.minDurationSec >= 0
          && data.createdByUid is string
          && data.updatedByUid is string
          && validBottleWashingJudgment(data);
      }

      function validRawMaterialUsageRecord(data) {
        return data.keys().hasOnly(['schemaVersion', 'recordDate', 'materials', 'createdByUid', 'createdByEmail', 'updatedByUid', 'createdAt', 'updatedAt'])
          && data.schemaVersion == 1
          && data.recordDate is string
          && data.materials is map
          && data.materials.size() > 0
          && data.materials.keys().hasOnly(['chinaSesame', 'importedSesame', 'koreanSesame', 'importedSesamePowderOil'])
          && (!('chinaSesame' in data.materials) || (data.materials.chinaSesame is number && data.materials.chinaSesame >= 0))
          && (!('importedSesame' in data.materials) || (data.materials.importedSesame is number && data.materials.importedSesame >= 0))
          && (!('koreanSesame' in data.materials) || (data.materials.koreanSesame is number && data.materials.koreanSesame >= 0))
          && (!('importedSesamePowderOil' in data.materials) || (data.materials.importedSesamePowderOil is number && data.materials.importedSesamePowderOil >= 0))
          && data.createdByUid is string
          && data.createdByEmail is string
          && data.updatedByUid is string
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      function validProductionRecord(data) {
        return data.keys().hasOnly(['schemaVersion', 'recordDate', 'items', 'createdByUid', 'createdByEmail', 'updatedByUid', 'createdAt', 'updatedAt'])
          && data.schemaVersion == 1
          && data.recordDate is string
          && data.items is list
          && data.items.size() > 0
          && data.items.size() <= 50
          && data.createdByUid is string
          && data.createdByEmail is string
          && data.updatedByUid is string
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      function validIncomingInspectionRecord(data) {
        return data.keys().hasOnly([
            'schemaVersion', 'recordDate', 'itemName', 'supplierName', 'purchaseQuantity',
            'offOdorDetected', 'packagingCondition', 'temperature', 'expirationCheck',
            'vehicleTemperature', 'testReportReceived', 'grade', 'writerConfirmName', 'notes',
            'createdByUid', 'createdByEmail', 'updatedByUid', 'createdAt', 'updatedAt'
          ])
          && data.schemaVersion == 1
          && data.recordDate is string
          && data.recordDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.itemName is string && data.itemName.size() > 0
          && data.supplierName is string && data.supplierName.size() > 0
          && data.purchaseQuantity is number && data.purchaseQuantity >= 0
          && data.offOdorDetected is bool
          && data.packagingCondition in ['good', 'poor']
          && data.temperature is string
          && data.expirationCheck in ['x', 'o']
          && data.vehicleTemperature is string
          && data.testReportReceived is bool
          && data.grade is string
          && data.writerConfirmName is string
          && data.notes is string
          && data.createdByUid is string
          && data.createdByEmail is string
          && data.updatedByUid is string
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      function validOperationalMetadata(data) {
        return data.schemaVersion == 1
          && data.recordDate is string
          && data.periodKey is string
          && data.cadence is string
          && data.createdByUid is string
          && data.createdByEmail is string
          && data.updatedByUid is string
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }
      function validCcpVerificationRecord(data) {
        return data.keys().hasOnly(['schemaVersion','recordDate','periodKey','cadence','inspectorName','answers','nonconformanceCount','deviationDetail','correctiveActionResult','actionBy','confirmedBy','createdByUid','createdByEmail','updatedByUid','createdAt','updatedAt'])
          && validOperationalMetadata(data) && data.cadence == 'monthly'
          && data.inspectorName is string && data.answers is map
          && data.nonconformanceCount is int && data.nonconformanceCount >= 0
          && data.deviationDetail is string && data.correctiveActionResult is string
          && data.actionBy is string && data.confirmedBy is string;
      }
      function validGeneralHygieneRecord(data) {
        return data.keys().hasOnly(['schemaVersion','recordDate','periodKey','inspectionGroup','cadence','inspectorName','answers','capturedPestCount','annualDates','notes','correctiveActionResult','actionBy','confirmedBy','createdByUid','createdByEmail','updatedByUid','createdAt','updatedAt'])
          && validOperationalMetadata(data)
          && data.inspectionGroup in ['pre_work','during_work','post_work','incoming','weekly','monthly','annual']
          && data.cadence in ['daily','event','weekly','monthly','annual']
          && data.inspectorName is string && data.answers is map && data.annualDates is map
          && (data.capturedPestCount == null || (data.capturedPestCount is number && data.capturedPestCount >= 0))
          && data.notes is string && data.correctiveActionResult is string
          && data.actionBy is string && data.confirmedBy is string;
      }
      function validCompressedAirRecord(data) {
        return data.keys().hasOnly(['schemaVersion','recordDate','periodKey','managementMonth','cadence','responsibleName','filters','notes','createdByUid','createdByEmail','updatedByUid','createdAt','updatedAt'])
          && validOperationalMetadata(data) && data.cadence == 'monthly'
          && data.managementMonth is string && data.responsibleName is string
          && data.filters is list && data.filters.size() == 3 && data.notes is string;
      }
      function validPestControlRecord(data) {
        return data.keys().hasOnly(['schemaVersion','recordDate','periodKey','cadence','inspectorName','devices','deviationCause','correctiveAction','actionBy','confirmedBy','createdByUid','createdByEmail','updatedByUid','createdAt','updatedAt'])
          && validOperationalMetadata(data) && data.cadence == 'weekly'
          && data.inspectorName is string && data.devices is list && data.devices.size() == 24
          && data.deviationCause is string && data.correctiveAction is string
          && data.actionBy is string && data.confirmedBy is string;
      }

      // Order approval is deliberately isolated from ERP, shipments and message sending.
      function orderManager() {
        let user = profile().data;
        return signedIn() && user.isActive == true && user.get('approvalStatus', 'approved') == 'approved'
          && user.role in ['manager', 'admin'];
      }
      function orderText(value, maxLength, required) {
        return value is string && value.size() <= maxLength
          && (!required || value.matches('(?s).*\\S.*'));
      }
      function orderDate(value) {
        return value is string && (value == ''
          || value.matches('^[0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))$')
          || value.matches('^([0-9]{2}(0[48]|[2468][048]|[13579][26])|([02468][048]|[13579][26])00)-02-29$'));
      }
      function orderLine(position) {
        let line = request.resource.data.draft.lines[position];
        let product = line.productName;
        let specification = line.specification;
        let unit = line.unit;
        let quantity = line.quantity;
        // All four fields below are required, so an exact key count also excludes extras.
        return line.keys().size() == 4
          && (product + specification + unit).matches('(?s)^.{0,430}$')
          && quantity >= 0 && quantity <= 1000000
          && (request.resource.data.status != 'approved' || (product.matches('(?s).*\\S.*') && unit.matches('(?s).*\\S.*') && quantity > 0));
      }
      function orderLines(ready) {
        let lines = request.resource.data.draft.lines;
        let count = lines.size();
        return lines is list && count <= 5 && (!ready || count > 0)
          && (count < 1 || orderLine(0)) && (count < 2 || orderLine(1))
          && (count < 3 || orderLine(2)) && (count < 4 || orderLine(3))
          && (count < 5 || orderLine(4));
      }
      function orderDraft(draft, ready) {
        return draft is map && draft.keys().size() == 6
          && orderDate(draft.deliveryDate) && (!ready || draft.deliveryDate != '')
          && draft.deliveryMethod in ['courier', 'direct', 'pickup', 'undetermined']
          && (!ready || draft.deliveryMethod != 'undetermined')
          && orderText(draft.recipientName, 120, ready) && orderText(draft.recipientPhone, 50, ready)
          && orderText(draft.deliveryAddress, 500, ready && draft.deliveryMethod != 'pickup')
          && orderLines(ready);
      }
      function orderChecks(checks, checked) {
        return checks is map && checks.keys().size() == 3
          && checks.identity == checked && checks.items == checked && checks.delivery == checked;
      }
      function validOrderRequest(data) {
        let ready = data.status == 'approved';
        return data.keys().size() == 21
          && data.schemaVersion == 1 && orderText(data.customerName, 120, true)
          && data.customerGroup in ['wedding', 'school', 'distributor', 'hotel', 'other']
          && data.sourceChannel in ['kakao', 'sms', 'email', 'hotel_erp', 'manual']
          && orderText(data.sourceText, 20000, true) && orderText(data.sourceReference, 500, false)
          && data.receivedAt is timestamp && data.createdAt is timestamp && data.updatedAt == request.time
          && orderText(data.createdByUid, 128, true) && orderText(data.createdByName, 200, true)
          && data.revision is int && data.revision > 0
          && data.status in ['pending_review', 'needs_information', 'approved', 'rejected']
          && orderDraft(data.draft, ready)
          && orderText(data.reviewNotes, 2000, false)
          && orderText(data.reviewedByUid, 128, false) && orderText(data.reviewedByName, 200, false)
          && (data.reviewedAt == null || data.reviewedAt is timestamp)
          && data.approvedRevision is int && data.isTest is bool
          && orderChecks(data.reviewChecks, ready);
      }
      function orderReviewReset(data) {
        return data.status == 'pending_review' && data.reviewNotes == ''
          && data.reviewedByUid == '' && data.reviewedByName == '' && data.reviewedAt == null
          && data.approvedRevision == 0 && orderChecks(data.reviewChecks, false);
      }
      // A decision cannot change draft fields. Their schema was checked when saved;
      // only the additional completeness conditions need checking again for approval.
      function orderLineReady(position) {
        let line = request.resource.data.draft.lines[position];
        return line.productName.matches('(?s).*\\S.*') && line.unit.matches('(?s).*\\S.*') && line.quantity > 0;
      }
      function orderApprovalReady() {
        let draft = request.resource.data.draft;
        let count = draft.lines.size();
        return draft.deliveryDate != '' && draft.deliveryMethod != 'undetermined'
          && draft.recipientName.matches('(?s).*\\S.*') && draft.recipientPhone.matches('(?s).*\\S.*')
          && (draft.deliveryMethod == 'pickup' || draft.deliveryAddress.matches('(?s).*\\S.*'))
          && count > 0 && count <= 5
          && orderLineReady(0) && (count < 2 || orderLineReady(1))
          && (count < 3 || orderLineReady(2)) && (count < 4 || orderLineReady(3))
          && (count < 5 || orderLineReady(4));
      }
      function orderDecision(data) {
        let approved = data.status == 'approved';
        return resource.data.status in ['pending_review', 'needs_information']
          && data.status in ['approved', 'needs_information', 'rejected']
          && data.revision == resource.data.revision
          && data.reviewedByUid == request.auth.uid && orderText(data.reviewedByName, 200, true)
          && data.reviewedAt == request.time && data.updatedAt == request.time
          && orderText(data.reviewNotes, 2000, false) && orderChecks(data.reviewChecks, approved)
          && data.approvedRevision is int
          && data.approvedRevision == (approved ? data.revision : 0)
          && (approved || data.reviewNotes.matches('(?s).*\\S.*'))
          && (!approved || orderApprovalReady())
          && data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewNotes', 'reviewChecks', 'reviewedByUid', 'reviewedByName', 'reviewedAt', 'approvedRevision', 'updatedAt']);
      }
      function orderRevisionArchived(orderId) {
        let archive = getAfter(/databases/$(database)/documents/orderRequests/$(orderId)/versions/$(string(resource.data.revision))).data;
        return archive.record == resource.data && archive.archivedAt == request.time
          && archive.archivedByUid == request.auth.uid;
      }

      function validErpCustomer(data, customerCode) {
        return data.keys().hasOnly(['schemaVersion', 'code', 'name', 'revision', 'createdAt', 'createdByUid', 'createdByName', 'updatedAt', 'updatedByUid', 'updatedByName'])
          && data.schemaVersion == 1
          && data.code == customerCode && data.code is string && data.code.size() > 0 && data.code.size() <= 100
          && !data.code.matches('.*[\\s/\\x00-\\x1f\\x7f].*')
          && !(data.code in ['.', '..']) && !data.code.matches('^__.*__$')
          && data.name is string && data.name.size() > 0 && data.name.size() <= 200
          && !data.name.matches('^\\s.*|.*\\s$|.*[\\x00-\\x1f\\x7f].*')
          && data.revision is int && data.revision >= 1
          && data.createdAt is timestamp && data.updatedAt is timestamp
          && data.createdByUid is string && data.createdByName is string
          && data.updatedByUid == request.auth.uid && data.updatedByName is string;
      }
      // AI is a proposal. These records use the signed-in human's existing authority;
      // the mail collector and model have no write/approval identity of their own.
      function orderAiSourceCurrent(data, intakeId) {
        let textPath = /databases/$(database)/documents/orderTextSources/$(intakeId);
        let mailPath = /databases/$(database)/documents/mailIntakes/$(intakeId);
        return exists(textPath)
          ? (get(textPath).data.schemaVersion == 1 && get(textPath).data.scope == 'school_meal'
            && data.sourceHash == get(textPath).data.sha256)
          : (exists(mailPath) && data.sourceHash == get(mailPath).data.rawStorage.sha256
            && get(mailPath).data.account == 'official@dmnfood.co.kr');
      }
      match /orderTextSources/{sourceId} {
        function validPastedText(data) {
          return data.keys().hasOnly(['schemaVersion', 'channel', 'scope', 'text', 'sha256', 'title', 'createdByUid', 'createdAt'])
            && data.text is string && data.text.size() > 0 && data.text.size() <= 20000;
        }
        function validPastedImage(data) {
          return data.keys().hasOnly(['schemaVersion', 'kind', 'channel', 'scope', 'sha256', 'title', 'fileName', 'mimeType', 'byteLength', 'contentBase64', 'createdByUid', 'createdAt'])
            && data.kind == 'image' && data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 250
            && data.mimeType in ['image/png', 'image/jpeg']
            && data.byteLength is int && data.byteLength > 0 && data.byteLength <= 614400
            && data.contentBase64 is string && data.contentBase64.size() > 0 && data.contentBase64.size() <= 819200
            && data.contentBase64.matches('^[A-Za-z0-9+/]*={0,2}$');
        }
        function validTextSource(data) {
          return sourceId.matches('^[a-f0-9]{64}$')
            && !exists(/databases/$(database)/documents/mailIntakes/$(sourceId))
            && (data.get('kind', '') == 'image' ? validPastedImage(data) : validPastedText(data))
            && data.schemaVersion == 1 && data.channel in ['kakao', 'sms'] && data.scope == 'school_meal'
            && data.sha256 is string && data.sha256.matches('^[a-f0-9]{64}$')
            && data.title is string && data.title.size() > 0 && data.title.size() <= 80
            && data.createdByUid == request.auth.uid && data.createdAt == request.time;
        }
        allow read: if approvedManagerOrAdmin();
        allow create: if approvedManagerOrAdmin() && validTextSource(request.resource.data);
        // Original pasted messages are immutable. A correction is a new intake.
      }
      function validOrderAiRecord(data, intakeId) {
        return data.keys().hasOnly(['schemaVersion', 'intakeId', 'sourceHash', 'revision', 'status', 'analysis', 'modelOutput', 'groupIds', 'conversation', 'createdByUid', 'updatedByUid', 'createdAt', 'updatedAt', 'reviewedGroupIds', 'reviewedExclusions', 'confirmedRevision', 'confirmedAt', 'confirmedByUid'])
          && intakeId.matches('^[a-f0-9]{64}$') && data.schemaVersion == 1 && data.intakeId == intakeId
          && data.sourceHash is string && data.sourceHash.matches('^[a-f0-9]{64}$')
          && orderAiSourceCurrent(data, intakeId)
          && data.revision is int && data.revision >= 1 && data.revision <= 10000
          && data.analysis is map && data.analysis.schemaVersion == 1
          && data.analysis.id == intakeId && data.analysis.intakeId == intakeId && data.analysis.sourceHash == data.sourceHash
          && data.analysis.status == 'needs_review' && data.analysis.canConfirm == false
          && data.analysis.readyForReview is bool && data.analysis.blockers is list && data.analysis.exclusions is list
          && data.analysis.groups is list && data.analysis.groups.size() <= 1000
          && data.modelOutput is map && data.groupIds is list && data.groupIds.size() == data.analysis.groups.size()
          && data.conversation is list && data.conversation.size() >= 2 && data.conversation.size() <= 24
          && data.reviewedGroupIds is list && data.reviewedExclusions is bool && data.createdByUid is string && data.updatedByUid == request.auth.uid
          && data.createdAt is timestamp && data.updatedAt == request.time;
      }
      function orderAiDraft(data) {
        return data.status == 'needs_review' && data.analysis.revision == data.revision
          && data.reviewedGroupIds.size() == 0 && data.reviewedExclusions == false && data.confirmedRevision == null && data.confirmedAt == null && data.confirmedByUid == null;
      }
      function orderAiLegacyCustomerCurrent(customer) {
        let master = get(/databases/$(database)/documents/erpCustomers/$(customer.code)).data;
        return customer.keys().hasOnly(['code', 'name', 'revision']) && customer.code is string && customer.name == master.name && customer.revision == master.revision;
      }
      function orderAiSchoolCustomerCurrent(customer) {
        let catalog = get(/databases/$(database)/documents/settings/schoolMealCompanies).data;
        return customer.keys().hasOnly(['id', 'name', 'revision', 'source', 'erpCode'])
          && customer.source == 'school_meal' && customer.erpCode == null
          && customer.id is string && customer.id.matches('^school-[a-f0-9]{24}$')
          && customer.name is string && customer.revision == catalog.revision && catalog.schemaVersion == 1
          && {'id': customer.id, 'name': customer.name} in catalog.companies;
      }
      function orderAiCustomerCurrent(customer) {
        return customer is map && (customer.get('source', '') == 'school_meal'
          ? orderAiSchoolCustomerCurrent(customer) : orderAiLegacyCustomerCurrent(customer));
      }
      // The weekly school-meal roster is the canonical company list for order
      // review. Its internal IDs do not create or imply ERP customer codes.
      match /settings/schoolMealCompanies {
        function validCatalog() {
          return request.resource.data.keys().hasOnly(['schemaVersion', 'revision', 'companies', 'updatedAt', 'updatedByUid'])
            && request.resource.data.schemaVersion == 1 && request.resource.data.revision is int
            && request.resource.data.revision >= 1 && request.resource.data.companies is list
            && request.resource.data.companies.size() <= 200
            && request.resource.data.updatedAt == request.time && request.resource.data.updatedByUid == request.auth.uid;
        }
        allow read: if approvedActiveUser();
        allow create: if approvedManagerOrAdmin() && validCatalog() && request.resource.data.revision == 1;
        allow update: if approvedManagerOrAdmin() && validCatalog() && request.resource.data.revision == resource.data.revision + 1;
      }
      match /orderAiAnalyses/{intakeId} {
        allow read: if approvedManagerOrAdmin();
        allow create: if approvedManagerOrAdmin() && validOrderAiRecord(request.resource.data, intakeId)
          && orderAiDraft(request.resource.data) && request.resource.data.revision == 1
          && request.resource.data.createdByUid == request.auth.uid && request.resource.data.createdAt == request.time;
